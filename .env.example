# Database Configuration
# Use local host ports (5433, 6380) if running tests/app locally against docker containers
DATABASE_URL=postgresql+psycopg2://listenery:listenery@127.0.0.1:5433/listenery
REDIS_URL=redis://127.0.0.1:6380/0

# Dispatch settings
DISPATCH_POLL_INTERVAL_SECONDS=10

# Docker Compose Configuration (exposed ports and credentials)
POSTGRES_USER=listenery
POSTGRES_PASSWORD=listenery
POSTGRES_DB=listenery
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8000
